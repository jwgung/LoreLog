{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreLog",
  "version": "0.1.0",
  "identifier": "com.lorelog.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LoreLog",
        "label": "main",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.ts.net:* http://*.ts.net:* http://127.0.0.1:* http://[::1]:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "LoreLog desktop: assistant, PC collector and the vault",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jwgung/LoreLog/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NDlFMjQ3QkY0MTgzM0IKUldRN2cwRy9SK0pKcE90cXRMVGtwU3BNTGphUXMyNUdldlVxMWpFbmZFYlhQZXY2b3ZvY2FVWk4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
