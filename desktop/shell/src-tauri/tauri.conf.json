{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreLog",
  "version": "0.1.0",
  "identifier": "com.lorelog.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LoreLog",
        "label": "main",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://*.ts.net:* http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
