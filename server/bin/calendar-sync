#!/usr/bin/env python3
"""Import events (VEVENT) from CalDAV calendars into the vault as Events/ notes. Read-only mirror (never writes to the server).

- Fetches the events of a window (default: 400 days back to 400 days ahead) with REPORT. If the server expands
  recurring events, each occurrence becomes its own note.
- Notes use the same frontmatter as the existing Events/ notes created by the Calendar Notes plugin.
- An existing event is recognised by (dav_uid, start). Only events whose etag changed are rewritten.
  Notes of events that disappeared from the server are not deleted.

Settings live in ~/.config/vault-sync/ :
  env           secrets only (KEY=VALUE, mode 600): CALDAV_USER / CALDAV_PASSWORD (default: IMAP_USER / IMAP_PASSWORD)
  sources.toml  what to collect, under [calendar]: urls, past_days, future_days
                (env may also carry CALDAV_URL (comma-separated), CALDAV_PAST_DAYS, CALDAV_FUTURE_DAYS; sources.toml wins)
Prefer `life add calendar` and `life sync` over editing these by hand.

Exit status: 0 on success, 1 if any calendar could not be read.

Usage: calendar-sync [--dry-run] [--list [SERVER_URL]] [--selftest] [-h]
  --list   discover the account's calendars and print: name, URL, supported components (tab-separated).
           Without SERVER_URL it starts from the first configured URL.
"""
import base64
import os
import re
import sys
import tomllib
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from urllib.parse import urlsplit
from xml.sax.saxutils import escape
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

try:
    from zoneinfo import ZoneInfo
except Exception:  # pragma: no cover
    ZoneInfo = None

VAULT = Path(os.environ.get("OBSIDIAN_VAULT", "/home/capalace/Obsidian"))
ENV_FILE = Path.home() / ".config/vault-sync/env"
SOURCES_FILE = Path.home() / ".config/vault-sync/sources.toml"
NS = {"d": "DAV:", "c": "urn:ietf:params:xml:ns:caldav"}


def load_env():
    cfg = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                cfg[k.strip()] = v.strip().strip('"').strip("'")
    if SOURCES_FILE.exists():  # sources.toml (non-secret settings: what to collect) overrides env
        c = tomllib.loads(SOURCES_FILE.read_text(encoding="utf-8")).get("calendar", {})
        if "urls" in c:
            cfg["CALDAV_URL"] = ",".join(c["urls"])
        for toml_key, env_key in (("past_days", "CALDAV_PAST_DAYS"), ("future_days", "CALDAV_FUTURE_DAYS")):
            if toml_key in c:
                cfg[env_key] = str(c[toml_key])
    return cfg


def unfold(text):
    return re.sub(r"\r?\n[ \t]", "", text).splitlines()


def unescape(v):
    return v.replace("\\n", "\n").replace("\\N", "\n").replace("\\,", ",").replace("\\;", ";").replace("\\\\", "\\")


def parse_prop(line):
    head, _, value = line.partition(":")
    name, *params = head.split(";")
    p = {}
    for x in params:
        k, _, v = x.partition("=")
        p[k.upper()] = v.strip('"')
    return name.upper(), p, value


def to_local(value, params):
    """iCal date/time -> (local naive ISO string, all-day flag)."""
    value = value.strip()
    if len(value) == 8:
        d = datetime.strptime(value, "%Y%m%d")
        return d.strftime("%Y-%m-%d"), True
    utc = value.endswith("Z")
    dt = datetime.strptime(value.rstrip("Z"), "%Y%m%dT%H%M%S")
    if utc:
        dt = dt.replace(tzinfo=timezone.utc).astimezone().replace(tzinfo=None)
    elif params.get("TZID") and ZoneInfo:
        try:
            dt = dt.replace(tzinfo=ZoneInfo(params["TZID"])).astimezone().replace(tzinfo=None)
        except Exception:
            pass
    return dt.strftime("%Y-%m-%dT%H:%M:%S"), False


def addr(value, params):
    a = re.sub(r"(?i)^mailto:", "", value.strip())
    cn = params.get("CN", "").strip()
    return f"{cn} <{a}>" if cn else f"<{a}>"


def parse_events(ics):
    events, cur = [], None
    for line in unfold(ics):
        if line.upper() == "BEGIN:VEVENT":
            cur = {"attendees": []}
        elif line.upper() == "END:VEVENT" and cur is not None:
            events.append(cur)
            cur = None
        elif cur is not None and ":" in line:
            name, params, value = parse_prop(line)
            if name == "UID":
                cur["uid"] = value.strip()
            elif name == "SUMMARY":
                cur["title"] = unescape(value).strip()
            elif name == "DESCRIPTION":
                cur["description"] = unescape(value).strip()
            elif name == "LOCATION":
                cur["location"] = unescape(value).strip()
            elif name == "DTSTART":
                cur["start"], cur["all_day"] = to_local(value, params)
            elif name == "DTEND":
                cur["end"], _ = to_local(value, params)
            elif name == "ATTENDEE":
                cur["attendees"].append(addr(value, params))
            elif name == "ORGANIZER":
                cur["organizer"] = addr(value, params)
            elif name == "STATUS":
                cur["status"] = value.strip()
    return [e for e in events if e.get("uid") and e.get("start")]


def safe_name(title):
    s = title.replace("|", "_")
    s = re.sub(r'[\/\\:*?"<>#^\[\]]', " ", s)
    return re.sub(r"\s+", " ", s).strip()[:80].strip() or "untitled"


def yaml_str(s):
    s = re.sub(r"\s+", " ", s or "").strip()
    if not s or re.search(r"[:#\[\]{}&*!|>'\"%@`,]", s) or s != s.strip() or s[0] in "-?":
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def render(ev, source, etag):
    title = ev.get("title") or "(untitled)"
    lines = [
        "---", "type: event", f"dav_uid: {ev['uid']}", f"dav_source: {source}", f"dav_etag: {yaml_str(etag) if etag else ''}",
        "dav_state: live", f"title: {yaml_str(title)}", f"start: {ev['start']}", f"end: {ev.get('end', ev['start'])}",
        f"all_day: {'true' if ev.get('all_day') else 'false'}", f"location: {yaml_str(ev.get('location', ''))}",
        f"online: {'true' if re.search(r'https?://', ev.get('location', '') + ev.get('description', '')) else 'false'}",
    ]
    if ev["attendees"]:
        lines.append("attendees:")
        lines += [f"  - {a}" for a in sorted(set(ev["attendees"]))]  # the server sends ATTENDEEs in a different order on every call; sort so a note never changes without a real change
    if ev.get("organizer"):
        lines.append(f"organizer: {ev['organizer']}")
    lines.append("---")
    body = "%% dav:begin %%\n" + (ev.get("description") or "") + "\n"
    rel = f"Events/{ev['start'][:10]} {safe_name(title)}.md"
    return rel, "\n".join(lines) + "\n" + body


def existing_events():
    """(dav_uid, start) -> (path, etag)"""
    out = {}
    for p in (VAULT / "Events").glob("*.md"):
        head = p.read_text(encoding="utf-8", errors="replace")[:2500]
        u = re.search(r"^dav_uid:\s*(.+)$", head, re.M)
        s = re.search(r"^start:\s*(.+)$", head, re.M)
        e = re.search(r"^dav_etag:\s*(.*)$", head, re.M)
        if u and s:
            out[(u.group(1).strip(), s.group(1).strip())] = (p, (e.group(1).strip() if e else ""))
    return out


def etag_key(value):
    """Compare etags regardless of how they were quoted in the note ('"x"', "\"x\"" or bare)."""
    return re.sub(r"[\\'\"]", "", value or "").strip()


def report(url, user, password, start, end, expand):
    exp = f'<c:expand start="{start}" end="{end}"/>' if expand else ""
    body = (f'<?xml version="1.0" encoding="utf-8"?><c:calendar-query xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
            f'<d:prop><d:getetag/><c:calendar-data>{exp}</c:calendar-data></d:prop>'
            f'<c:filter><c:comp-filter name="VCALENDAR"><c:comp-filter name="VEVENT">'
            f'<c:time-range start="{start}" end="{end}"/></c:comp-filter></c:comp-filter></c:filter></c:calendar-query>').encode()
    auth = base64.b64encode(f"{user}:{password}".encode()).decode()
    req = urllib.request.Request(url, data=body, method="REPORT",
                                 headers={"Depth": "1", "Content-Type": "application/xml; charset=utf-8", "Authorization": f"Basic {auth}"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()


def parse_multistatus(xml_bytes):
    root = ET.fromstring(xml_bytes)
    for resp in root.findall("d:response", NS):
        etag = resp.findtext(".//d:getetag", default="", namespaces=NS)
        data = resp.findtext(".//c:calendar-data", default="", namespaces=NS)
        if data:
            yield etag, data


def multiget(url, user, password, hrefs):
    """CalDAV calendar-multiget: fetch the event data of specific resources."""
    body = ('<?xml version="1.0" encoding="utf-8"?><c:calendar-multiget xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
            '<d:prop><d:getetag/><c:calendar-data/></d:prop>'
            + "".join(f"<d:href>{escape(h)}</d:href>" for h in hrefs) + "</c:calendar-multiget>").encode()
    auth = base64.b64encode(f"{user}:{password}".encode()).decode()
    req = urllib.request.Request(url, data=body, method="REPORT",
                                 headers={"Depth": "1", "Content-Type": "application/xml; charset=utf-8", "Authorization": f"Basic {auth}"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return r.read()


def events_from(url, user, password, xml_bytes, batch=50):
    """Yield (etag, ics). Some servers (e.g. NAVER WORKS) answer a calendar-query with etags only,
    so the event data of those resources is fetched with calendar-multiget in batches."""
    own = urlsplit(url).path.rstrip("/")
    missing = []
    for resp in ET.fromstring(xml_bytes).findall("d:response", NS):
        etag = resp.findtext(".//d:getetag", default="", namespaces=NS)
        data = resp.findtext(".//c:calendar-data", default="", namespaces=NS)
        href = (resp.findtext("d:href", default="", namespaces=NS) or "").strip()
        if data:
            yield etag, data
        elif href and href.rstrip("/") != own:  # skip the calendar collection itself
            missing.append(href)
    for i in range(0, len(missing), batch):
        yield from parse_multistatus(multiget(url, user, password, missing[i:i + batch]))


def propfind(url, user, password, body, depth):
    auth = base64.b64encode(f"{user}:{password}".encode()).decode()
    req = urllib.request.Request(url, data=body.encode(), method="PROPFIND",
                                 headers={"Depth": depth, "Content-Type": "application/xml; charset=utf-8", "Authorization": f"Basic {auth}"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return ET.fromstring(r.read())


def list_calendars(base, user, password):
    """CalDAV discovery: principal -> calendar home -> calendar list. Prints the URLs so they can go into sources.toml."""
    from urllib.parse import urljoin
    head = '<?xml version="1.0" encoding="utf-8"?><d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav"><d:prop>'
    def step(name, url, props, depth):
        try:
            return propfind(url, user, password, head + props + "</d:prop></d:propfind>", depth)
        except urllib.error.HTTPError as e:
            print(f"  [{name}] {url} -> HTTP {e.code} {e.reason}", file=sys.stderr)
        except Exception as e:
            print(f"  [{name}] {url} -> {type(e).__name__}", file=sys.stderr)
        return None

    home = None
    for start in (base, urljoin(base, "/.well-known/caldav"), urljoin(base, "/")):
        root = step("discover", start, "<d:current-user-principal/><c:calendar-home-set/>", "0")
        if root is None:
            continue
        h = root.findtext(".//c:calendar-home-set/d:href", namespaces=NS)
        if not h:
            p = root.findtext(".//d:current-user-principal/d:href", namespaces=NS)
            if p:
                r2 = step("principal", urljoin(start, p), "<c:calendar-home-set/>", "0")
                h = r2.findtext(".//c:calendar-home-set/d:href", namespaces=NS) if r2 is not None else None
                start = urljoin(start, p)
        if h:
            home = urljoin(start, h)
            break
    if not home:
        print("Could not find the calendar home. See the HTTP codes above.", file=sys.stderr)
        return 1
    root = step("list", home, "<d:displayname/><d:resourcetype/><c:supported-calendar-component-set/>", "1")
    if root is None:
        return 1
    found = 0
    for resp in root.findall("d:response", NS):
        if resp.find(".//d:resourcetype/c:calendar", NS) is None:
            continue
        comps = ",".join(c.get("name", "") for c in resp.findall(".//c:supported-calendar-component-set/c:comp", NS)) or "?"
        print(f"{resp.findtext('d:propstat/d:prop/d:displayname', default='(unnamed)', namespaces=NS)}\t{urljoin(home, resp.findtext('d:href', namespaces=NS))}\t{comps}")
        found += 1
    print(f"{found} calendars (only events are collected, so use one that supports VEVENT)", file=sys.stderr)
    return 0


def selftest():
    ics = ("BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nUID:u1@x\r\nSUMMARY:이현민 | 회의\\, 킥오프\r\n"
           "DTSTART;TZID=Asia/Seoul:20260921T130000\r\nDTEND;TZID=Asia/Seoul:20260921T140000\r\nLOCATION:소회의실 3\r\n"
           "ATTENDEE;CN=\"김한얼\";PARTSTAT=NEEDS-ACTION:mailto:hekim@isaac-eng.com\r\nORGANIZER;CN=송진호:mailto:jinhsong@isaac-eng.com\r\n"
           "DESCRIPTION:첫 줄\\n둘째 줄\r\n END:VEVENT\r\nEND:VCALENDAR\r\n")
    ics = ics.replace("\r\n END:VEVENT", "\r\nEND:VEVENT")
    evs = parse_events(ics)
    assert len(evs) == 1 and evs[0]["title"] == "이현민 | 회의, 킥오프" and evs[0]["start"].startswith("2026-09-21T13:00")
    rel, note = render(evs[0], "caldav/test", '"abc"')
    print(rel); print(note)
    assert rel == "Events/2026-09-21 이현민 _ 회의, 킥오프.md" and "dav_uid: u1@x" in note and "  - 김한얼 <hekim@isaac-eng.com>" in note
    assert to_local("20260921", {}) == ("2026-09-21", True)
    assert etag_key('"\\"2025-10-29 15:38:34\\""') == etag_key("'\"2025-10-29 15:38:34\"'") == etag_key('"2025-10-29 15:38:34"') == "2025-10-29 15:38:34"
    # a query answer that already carries data is used as is, and the collection itself is never fetched
    xml = (b'<d:multistatus xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
           b'<d:response><d:href>/cal/</d:href><d:propstat><d:prop><d:getetag>"c"</d:getetag></d:prop></d:propstat></d:response>'
           b'<d:response><d:href>/cal/a.ics</d:href><d:propstat><d:prop><d:getetag>"e1"</d:getetag>'
           b'<c:calendar-data>BEGIN:VCALENDAR</c:calendar-data></d:prop></d:propstat></d:response></d:multistatus>')
    assert list(events_from("https://h/cal/", "u", "p", xml)) == [('"e1"', "BEGIN:VCALENDAR")]
    print("selftest ok")


def acquire_lock(name):
    """Non-blocking exclusive lock, so a timer run and a manual run can never overlap (both would write the same notes).
    Returns a handle to keep alive for the whole run, True where file locks are unavailable (Windows), or None if busy."""
    try:
        import fcntl
    except ImportError:
        return True
    path = Path.home() / ".local/share/vault-sync" / f"{name}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fh = open(path, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def main():
    args = sys.argv[1:]
    if {"-h", "--help"} & set(args):
        print(__doc__.strip())
        return
    if "--selftest" in args:
        return selftest()
    dry = "--dry-run" in args
    lock = True if (dry or "--list" in args) else acquire_lock("calendar-sync")  # dry runs and --list write nothing
    if lock is None:
        print("Another calendar-sync run is in progress; skipping this one.")
        return 0
    cfg = load_env()
    urls = [u.strip() for u in cfg.get("CALDAV_URL", "").split(",") if u.strip()]
    user = cfg.get("CALDAV_USER") or cfg.get("IMAP_USER")
    pw = cfg.get("CALDAV_PASSWORD") or cfg.get("IMAP_PASSWORD")
    if not (urls and user and pw):
        print(f"Missing calendar URL or credentials (env: {ENV_FILE}, sources.toml: {SOURCES_FILE}). Run `life add calendar`.", file=sys.stderr)
        sys.exit(2)
    if "--list" in args:  # --list [SERVER_URL]: without a URL, start from the first configured one
        i = args.index("--list") + 1
        base = args[i] if i < len(args) and not args[i].startswith("-") else urls[0]
        return list_calendars(base, user, pw)
    today = date.today()
    start = (today - timedelta(days=int(cfg.get("CALDAV_PAST_DAYS", "400")))).strftime("%Y%m%dT000000Z")
    end = (today + timedelta(days=int(cfg.get("CALDAV_FUTURE_DAYS", "400")))).strftime("%Y%m%dT000000Z")
    known = existing_events()
    created = updated = same = 0
    failed = False
    for url in urls:
        try:
            try:
                xml_bytes = report(url, user, pw, start, end, expand=True)
            except urllib.error.HTTPError:
                xml_bytes = report(url, user, pw, start, end, expand=False)  # server cannot expand: fall back to the original events only
            items = list(events_from(url, user, pw, xml_bytes))  # inside the try: a failing multiget counts as a failed calendar
        except Exception as e:
            why = f"HTTP {e.code} {e.reason}" if isinstance(e, urllib.error.HTTPError) else type(e).__name__
            print(f"CalDAV request failed ({why}): {url.rstrip('/').split('/')[-1]}", file=sys.stderr)
            failed = True
            continue
        source = "caldav/" + url.rstrip("/").split("/")[-1][:12]
        n = 0
        for etag, ics in items:
            for ev in parse_events(ics):
                n += 1
                key = (ev["uid"], ev["start"])
                rel, note = render(ev, source, etag)
                if key in known:
                    path, old = known[key]
                    if etag_key(old) == etag_key(etag):
                        same += 1
                        continue
                    if not dry:
                        path.write_text(note, encoding="utf-8")
                    updated += 1
                else:
                    f = VAULT / rel
                    i = 2
                    while f.exists():
                        f = VAULT / rel.replace(".md", f" ({i}).md")
                        i += 1
                    if not dry:
                        f.parent.mkdir(parents=True, exist_ok=True)
                        f.write_text(note, encoding="utf-8")
                        known[key] = (f, etag)
                    created += 1
        print(f"[{url.rstrip('/').split('/')[-1][:12]}] {n} events on server")
    print(f"{'[dry-run] ' if dry else ''}new notes {created}, updated {updated}, unchanged {same}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
