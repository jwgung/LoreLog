# 이 파일을 env 로 복사해서 값을 채우고 chmod 600 한다. (env 는 vault 밖이라 git 에 올라가지 않는다)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# 가져올 폴더(쉼표로 구분). 폴더 이름은 서버가 보여주는 그대로.
MAIL_FOLDERS=INBOX,Sent Messages
# 노트의 mail_source 접두사. 기존 Mailstone 노트와 같게 "account".
MAIL_ACCOUNT=account
# 선택: 이 날짜 이후 메일만 (YYYY-MM-DD)
# MAIL_SINCE=2024-01-01

# 캘린더(CalDAV). 여러 캘린더면 쉼표로 구분. 계정은 위 IMAP_USER/IMAP_PASSWORD 를 그대로 쓰며, 다르면 아래를 채운다.
CALDAV_URL=https://caldav.example.com/<계정>/calendar/<캘린더 id>/
# CALDAV_USER=
# CALDAV_PASSWORD=
# CALDAV_PAST_DAYS=400
# CALDAV_FUTURE_DAYS=400
