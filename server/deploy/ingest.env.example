# life-ingest 설정. 복사해서 ingest.env 로 만들고 값을 채운 뒤 chmod 600. (vault 밖이라 git 에 올라가지 않는다)
# 토큰은 충분히 길고 무작위여야 한다. 예: openssl rand -base64 32
INGEST_TOKEN=
# 받을 주소. 처음에는 로컬에서만 받는다. Tailscale 로 폰에서 보내려면 이 머신의 tailnet 주소(예: 100.101.171.95)로 바꾼다.
INGEST_BIND=127.0.0.1
INGEST_PORT=8765
# 기본 분류. LoreLog(음성·위치·통화 등)는 personal.
INGEST_CLASS=personal
# LIBRARIAN_ASK_LOG=off   # 비서가 사서에게 간 질문을 <data>/librarian-asks.ndjson에 남기지 않는다(기본은 남김, 90일)
INGEST_MAX_MB=20
# 비우면 OS 표준 위치(Linux ~/.local/share/life). 다른 곳에 두려면 경로를 쓴다.
# LIFE_DATA_DIR=
# HTTPS 가 필요하면 둘 다 채운다.
# INGEST_CERT=
# INGEST_KEY=
